# Discord Bot Token (Developer Portal で取得)
DISCORD_TOKEN=

# (任意) スラッシュコマンドを即時同期したい場合のテストギルドID
# 本番では空にすると全グローバル同期 (反映に最大1時間)
TEST_GUILD_ID=
# SQLite DB ファイルパス
DB_PATH=anniversary.db

# (任意) 環境名。エラー通知 JSON の "env" として送信されます。
ENV_NAME=development

# (任意) 未捕捉エラー発生時に JSON を POST する Webhook URL。
# 空なら通知を送信しません。スキーマは README.md を参照。
ERROR_WEBHOOK_URL=
